# Copia este archivo a .env.local y completa los valores.
# .env.local está en .gitignore (no se sube al repo).

# ── Base de datos MySQL ──
# En local: MySQL en Docker (ver LEEME-LOCAL.md).
# En producción: usar las credenciales del MySQL de Railway.
DB_AUPAIR_HOST=127.0.0.1
DB_AUPAIR_PORT=3307
DB_AUPAIR_USER=root
DB_AUPAIR_PASSWORD=root
DB_AUPAIR_NAME=destino_aupair

# ── Secretos JWT ──
# En local cualquier valor consistente sirve.
# En producción: generar secretos fuertes y NO reutilizar estos.
JWT_AUPAIR_SECRET=cambiar_en_produccion
JWT_SECRET=cambiar_en_produccion

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Correos (Resend) ──
# Vacío en local (no se envían correos). En producción: API key propia de Resend.
RESEND_API_KEY=
