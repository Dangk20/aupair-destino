# Copia este archivo a .env.local y completa los valores.
# .env.local está en .gitignore (no se sube al repo).

# ── Base de datos MySQL ──
# En local: MySQL en Docker (ver LEEME-LOCAL.md).
# En producción: usar las credenciales del MySQL de Railway.
DB_AUPAIR_HOST=127.0.0.1
DB_AUPAIR_PORT=3307
DB_AUPAIR_USER=root
DB_AUPAIR_PASSWORD=root
DB_AUPAIR_NAME=destino_aupair

# ── Secretos JWT ──
# En local cualquier valor consistente sirve.
# En producción: generar secretos fuertes y NO reutilizar estos.
JWT_AUPAIR_SECRET=cambiar_en_produccion
JWT_SECRET=cambiar_en_produccion

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Almacenamiento de archivos subidos ──
# Documentos de candidatas y recursos del curso. Va FUERA de public/: se sirven
# autenticados por /api/documentos y /api/sesion-recursos.
# En local, si se omite, usa <proyecto>/almacenamiento.
# En producción lo fija docker-compose (/app/almacenamiento, montado en volumen).
UPLOADS_DIR=

# ── Correos (Resend) ──
# En local se deja vacío: no se llama a Resend, los avisos se registran en la
# tabla `notificaciones` con estado='omitido' y se escriben en consola.
#
# En producción es OBLIGATORIA. Vacía significa que NO sale ningún correo:
# ni las notificaciones ni la recuperación de contraseña. Y como el fallo se
# registra en silencio, nadie se entera. Pasó: producción estuvo así desde el
# despliegue del 2026-07-23.
RESEND_API_KEY=

# Direcciones que NO deben recibir avisos de admin aunque tengan rol admin en
# la base, separadas por coma. Es la defensa contra mandarle correo a cuentas
# heredadas o de prueba que siguen con rol admin.
NOTIF_EXCLUIR_EMAILS=
